{
  "expo": {
    "name": "lego-library",
    "slug": "lego-library",
    "scheme": "lego-library",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/lego_logo.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.legolibrary"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/lego_logo.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.anonymous.legolibrary"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-notifications",
      "./plugins/withNetworkSecurityConfig"
    ],
    "extra": {
      "eas": {
        "projectId": "9b233da7-d95f-446e-a1fc-211fe39935bb"
      }
    },
    "owner": "vicestar"
  }
}
